// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  BANNED
  DELETED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MenuType {
  MAIN
  EXPLORE
  SETTINGS
}

enum AuthEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  REFRESH_SUCCESS
  REFRESH_REUSE_DETECTED
  LOGOUT
  LOGOUT_ALL
  SESSION_REVOKED
  PASSWORD_CHANGED
  API_KEY_CREATED
  API_KEY_REVOKED
}

model User {
  id              String     @id @default(uuid())
  email           String?    @unique
  phone           String?    @unique
  username        String     @unique

  passwordHash    String?    @map("password_hash")
  passwordAlgo    String?    @map("password_algo")
  status          UserStatus @default(ACTIVE)

  displayName     String?    @map("display_name")
  avatar          String?

  tokenVersion    Int        @default(0) @map("token_version")

  emailVerifiedAt DateTime?  @map("email_verified_at")
  phoneVerifiedAt DateTime?  @map("phone_verified_at")

  sessions        AuthSession[]
  auditLogs       AuditLog[]
  loginAttempts   LoginAttempt[]

  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  subscriptions Subscription[]
  watchHistory  WatchHistory[]
  videoLikes    VideoLike[]
  comments      Comment[]
  commentLikes  CommentLike[]

  @@index([status])
  @@map("users")
}

model AuthSession {
  id                  String        @id @default(uuid())
  userId              String        @map("user_id")
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  status              SessionStatus @default(ACTIVE)

  deviceId            String        @map("device_id")
  deviceName          String?       @map("device_name")
  userAgentHash       String?       @map("user_agent_hash")
  ipHash              String?       @map("ip_hash")

  refreshTokenHash    String        @map("refresh_token_hash")
  refreshTokenFamily  String        @map("refresh_token_family")
  refreshExpiresAt    DateTime      @map("refresh_expires_at")

  lastRotatedAt       DateTime?     @map("last_rotated_at")
  revokedAt           DateTime?     @map("revoked_at")
  lastSeenAt          DateTime?     @map("last_seen_at")

  devicePublicKey     String?       @map("device_public_key")
  dpopNonce           String?       @map("dpop_nonce")
  dpopNonceExpiresAt  DateTime?     @map("dpop_nonce_expires_at")

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt      @map("updated_at")

  @@index([userId, status])
  @@index([deviceId])
  @@index([refreshExpiresAt])
  @@map("auth_sessions")
}

model LoginAttempt {
  id          BigInt   @id @default(autoincrement())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  identifier  String
  ipHash      String?  @map("ip_hash")
  uaHash      String?  @map("ua_hash")
  success     Boolean
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([identifier, createdAt])
  @@index([ipHash, createdAt])
  @@map("login_attempts")
}

model AuditLog {
  id          BigInt        @id @default(autoincrement())
  userId      String?       @map("user_id")
  user        User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  event       AuthEventType
  sessionId   String?       @map("session_id")
  meta        Json?

  ipHash      String?       @map("ip_hash")
  uaHash      String?       @map("ua_hash")

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

// ==================== YouTube Data ====================

model Channel {
  id     String  @id
  name   String
  handle String?
  avatar String?
  banner String?

subscriberCount BigInt? @map("subscriber_count")
  subscriberCountText String? @map("subscriber_count_text")
  description         String? @db.Text

  videos    Video[]
  shorts    Short[]
  playlists Playlist[]

  subscriptions Subscription[]

  crawledAt DateTime @default(now()) @map("crawled_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  @@index([handle])
  @@map("channels")
}

model Video {
  id          String   @id

  title       String
  channelId   String?  @map("channel_id")
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  channelName String?  @map("channel_name")

  viewsText         String?  @map("views_text")
  durationText      String?  @map("duration_text")
  publishedTimeText String?  @map("published_time_text")

  viewCount         BigInt?  @map("view_count")
  durationSeconds   Int?     @map("duration_seconds")
  isLiveContent     Boolean  @default(false) @map("is_live_content")

  descriptionSnippet String?  @db.Text @map("description_snippet")
  thumbnails         Json?

  isAvailable       Boolean  @default(true)  @map("is_available")
  unavailableReason String?  @map("unavailable_reason")

  detailCrawledAt   DateTime? @map("detail_crawled_at")

  comments          Comment[]
  trendingSnapshots TrendingSnapshot[]
  searchResults     SearchResult[]
  playlistItems     PlaylistItem[]
  watchHistory WatchHistory[]
  videoLikes   VideoLike[]
  label        VideoLabel?

  crawledAt  DateTime  @default(now()) @map("crawled_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")

  @@index([channelId])
  @@index([crawledAt])
  @@index([isAvailable])
  @@map("videos")
}

model Short {
  id              String   @id

  title           String
  url             String
  channelId       String?  @map("channel_id")
  channel         Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  channelName     String?  @map("channel_name")

  viewCount       BigInt?  @map("view_count")
  durationSeconds Int?     @map("duration_seconds")
  thumbnails      Json?

  isAvailable     Boolean  @default(true) @map("is_available")

  crawledAt       DateTime @default(now()) @map("crawled_at")
  updatedAt       DateTime @updatedAt      @map("updated_at")

  @@index([crawledAt])
  @@index([channelId])
  @@map("shorts")
}

model TrendingSnapshot {
  id        BigInt   @id @default(autoincrement())
  videoId   String   @map("video_id")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  rank      Int
  category  String?

  crawledAt DateTime @default(now()) @map("crawled_at")

  @@index([crawledAt])
  @@index([videoId, crawledAt])
  @@map("trending_snapshots")
}

model SearchResult {
  id        BigInt   @id @default(autoincrement())
  videoId   String   @map("video_id")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  query     String
  rank      Int
  sort      String   @default("relevance")

  crawledAt DateTime @default(now()) @map("crawled_at")

  @@index([query, crawledAt])
  @@index([videoId])
  @@map("search_results")
}

model Comment {
  id      String  @id
  videoId String  @map("video_id")
  video   Video   @relation(fields: [videoId], references: [id], onDelete: Cascade)

  parentId String?   @map("parent_id")
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[] @relation("CommentReplies")

  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  author       String
  avatar       String?
  content      String   @db.Text
  likesCount   Int      @default(0) @map("likes_count")
  repliesCount Int      @default(0) @map("replies_count")
  publishedTimeText String? @map("published_time_text")

  crawledAt DateTime @default(now()) @map("crawled_at")
  likes     CommentLike[]

  @@index([videoId])
  @@index([parentId])
  @@index([videoId, crawledAt])
  @@index([userId])
  @@map("comments")
}

model CommentLike {
  userId    String  @map("user_id")
  commentId String  @map("comment_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, commentId])
  @@map("comment_likes")
}

model Playlist {
  id          String   @id
  channelId   String?  @map("channel_id")
  channel     Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  title       String
  description String?  @db.Text
  videoCount  Int?     @map("video_count")
  thumbnails  Json?

  items       PlaylistItem[]

  crawledAt   DateTime @default(now()) @map("crawled_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@index([channelId])
  @@map("playlists")
}

model PlaylistItem {
  id         BigInt   @id @default(autoincrement())
  playlistId String   @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  videoId    String   @map("video_id")
  video      Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  position   Int

  crawledAt  DateTime @default(now()) @map("crawled_at")

  @@unique([playlistId, videoId])
  @@index([videoId])
  @@map("playlist_items")
}

model Menu {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique

  icon        String?
  path        String?

  parentId    String?

  position    Int      @default(0)

  isVisible   Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  type MenuType @default(MAIN)

  @@index([parentId])

  @@map("menus")
}

model Subscription {
  id        BigInt   @id @default(autoincrement())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  channelId String   @map("channel_id")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, channelId])
  @@index([userId])
  @@index([channelId])

  @@map("subscriptions")
}

model WatchHistory {
  id        BigInt   @id @default(autoincrement())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId   String   @map("video_id")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  progress  Int      @default(0)

  watchedAt DateTime @default(now()) @map("watched_at")

  @@unique([userId, videoId])

  @@index([userId, watchedAt])
  @@index([videoId])

  @@map("watch_history")
}

model VideoLike {
  id        BigInt   @id @default(autoincrement())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  videoId   String   @map("video_id")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, videoId])

  @@index([videoId])
  @@index([userId])

  @@map("video_likes")
}

model PlaylistLike {
  id          BigInt   @id @default(autoincrement())

  userId      String   @map("user_id")
  playlistId  String   @map("playlist_id")

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, playlistId])

  @@index([userId])
  @@index([playlistId])

  @@map("playlist_likes")
}

model SavedPlaylist {
  id          BigInt   @id @default(autoincrement())

  userId      String   @map("user_id")
  playlistId  String   @map("playlist_id")

  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([userId, playlistId])

  @@index([userId])

  @@map("saved_playlists")
}

model SystemConfig {
  key         String   @id

  value       Json

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt      @map("updated_at")

  @@map("system_configs")
}

model Category {
  id    String @id
  name  String

  createdAt DateTime @default(now())

  @@map("categories")
}

model VideoLabel {
  id        BigInt   @id @default(autoincrement())
  videoId   String   @unique @map("video_id")
  video     Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  category  String
  quality   Int      @default(2)
  labeledAt DateTime @default(now()) @map("labeled_at")

  @@index([category])
  @@map("video_labels")
}

model UserPlaylist {
  id          String @id @default(uuid())

  userId      String @map("user_id")

  name        String
  description String?

  createdAt   DateTime @default(now())

  @@index([userId])

  @@map("user_playlists")
}