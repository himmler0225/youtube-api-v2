# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Token pepper — Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_PEPPER=your-32-byte-hex-pepper-here

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/youtube?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/youtube"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
# REDIS_URL=rediss://... (Upstash — overrides REDIS_HOST/PORT/PASSWORD if set)

# Internal service-to-service key (crawler → api)
INTERNAL_SERVICE_KEY=change-me-to-a-strong-random-secret

# Crawler service (api → crawler)
CRAWLER_URL=http://localhost:8000
CRAWLER_API_KEY=your-crawler-api-key
CRAWLER_WS_KEY=your-crawler-ws-key

# AI (Groq)
GROQ_API_KEY=

# Algolia Search
ALGOLIA_APP_ID=
ALGOLIA_SEARCH_KEY=
ALGOLIA_WRITE_KEY=

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3001,http://localhost:8080

# RabbitMQ (production — CloudAMQP)
# RABBITMQ_URL=amqps://...